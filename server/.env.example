# Copy to .env (never committed). The deploy never touches .env.
# OpenWeatherMap key with One Call 3.0 access (https://openweathermap.org/api/one-call-3).
OPENWEATHERMAP_API_KEY=
# Port the server listens on (127.0.0.1 only; Caddy fronts it). 8800 per hosting/sites.yaml.
PORT=8800
# OAuth web client id for Gmail (public value). Authorized JavaScript origin: https://start.nish.software
GOOGLE_CLIENT_ID=
# Where the Watchlist sheet fetches prices from (the browser calls it directly).
TRADING_URL=https://trading.nish.software
# Folder with the built app. Defaults to ../docs (the committed build).
# STATIC_DIR=
